# 🪐 旅行星球 后端环境变量模板，复制为 .env 后填入真实值。

# —— 服务 ——
HOST=0.0.0.0
PORT=8000
# 逗号分隔的前端来源，按 , 解析挂载 CORS，可填写多个
FRONTEND_ORIGINS=http://localhost:3000
# 仅预留给未来确需公网完整 URL 的场景；当前必须留空
PUBLIC_BASE_URL=

# —— 数据库 ——
DATABASE_URL=sqlite:///./data/travelplanet.db

# —— 鉴权（Demo 单用户，无感）——
DEFAULT_USER_ID=demo_user_001

# —— 静态资源根目录 ——
STATIC_ROOT=./static

# —— vivo 大模型网关 ——
VIVO_APP_KEY=
VIVO_CHAT_BASE_URL=https://api-ai.vivo.com.cn/v1
VIVO_CHAT_MODEL=Doubao-Seed-2.0-pro
VIVO_IMAGE_GENERATION_URL=https://api-ai.vivo.com.cn/api/v1/image_generation
VIVO_IMAGE_MODEL=Doubao-Seedream-4.5
VIVO_TEXT_TIMEOUT_SECONDS=120
# 行程规划（FC + plain JSON）单独超时；默认长于通用文本任务
VIVO_PLANNING_TIMEOUT_SECONDS=120
VIVO_IMAGE_TIMEOUT_SECONDS=120
VIVO_MAX_RETRY=1
# transient retry backoff; only applies after timeout/connection/5xx/429 failures
VIVO_RETRY_BACKOFF_SECONDS=1.0
# 图片生成接口组图开关；业务每次只需要一张明信片图，默认显式单图
VIVO_IMAGE_SEQUENTIAL_GENERATION=disabled
# —— DeepSeek 行程规划（OpenAI Chat Completions；思考模式由代码强制开启）——
# 选择 DeepSeek V4 Flash / Pro 前填写；使用当前 Doubao 时可留空
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# 生成流程内部并行度：只影响照片理解、文件读取和多张明信片图生图，不改变接口同步返回策略
PHOTO_ANALYZE_PARALLELISM=10
GENERATION_FILE_IO_PARALLELISM=4
GENERATION_IMAGE_PARALLELISM=5

# —— 工具链总开关 ——
TOOLS_ENABLED=true

# —— A 类：高德（最大化使用其全部能力）——
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
# 免费高德 Key 常见 QPS 上限为 3；后端会按该值节流所有 amap REST 请求
AMAP_MAX_QPS=3
# true 则 amap_* 走官方 MCP Server 而非 REST，全项目二选一
AMAP_MCP_ENABLED=true
AMAP_MCP_SSE_URL=https://mcp.amap.com/sse

# —— A 类：和风天气（可选）——
QWEATHER_API_KEY=
QWEATHER_BASE_URL=https://devapi.qweather.com

# —— A′ 类：社区 MCP ——
RAIL_MCP_ENABLED=true
# 12306 社区 MCP stdio 命令（默认 node 版，可用）；为空即自动降级 B，不报错
# Docker --env-file 会保留外层引号，此处有空格也不要加引号
RAIL_MCP_ENDPOINT=stdio:npx -y 12306-mcp
MCP_WAIT_READY_ON_STARTUP=true
MCP_STARTUP_TIMEOUT_SECONDS=60

# —— 工具通用超时/重试 ——
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRY=1
