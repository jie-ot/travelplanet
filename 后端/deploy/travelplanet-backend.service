[Unit]
Description=TravelPlanet FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/travelplanet_backend
EnvironmentFile=/home/ubuntu/travelplanet_backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/travelplanet_backend/.venv/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/travelplanet_backend/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
